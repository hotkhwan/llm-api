# Non-secret runtime settings only. Copy to a local environment; do not commit .env.
APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_CONCURRENCY=1024
SHUTDOWN_TIMEOUT=10s
# Optional local OpenAI-compatible endpoint. Empty keeps the deterministic fallback.
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=Qwen3.6-27B-MTP-GGUF
