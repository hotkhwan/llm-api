# Non-secret runtime settings only. Copy to a local environment; do not commit .env.
APP_ENV=development
APP_BASE_PATH=/dev/llm-api
# Controlled Alpha only; the gateway must strip caller-provided identity headers.
ALLOW_TRUSTED_IDENTITY_HEADER=true
OIDC_ISSUER=
OIDC_AUDIENCE=
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=120s
HTTP_IDLE_TIMEOUT=60s
HTTP_BODY_LIMIT_BYTES=67108864
HTTP_CONCURRENCY=1024
SHUTDOWN_TIMEOUT=10s
LOCAL_LLM_TIMEOUT=105s
# Optional local OpenAI-compatible endpoint. Empty keeps the deterministic fallback.
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=qwen3.6-27b-q8_0-mtp-16k
# Optional advisory visual QC. Empty keeps manual review/fail-open behavior.
SHOTVL_URL=
SHOTVL_MODEL=ShotVL-7B
SHOTVL_MODEL_REVISION=unversioned
SHOTVL_THRESHOLD=0.75
# Free local preview runtime. WAN_API_KEY is injected from Kubernetes Secret.
WAN_URL=
WAN_TIMEOUT=45m
# Mandatory Product Fidelity gate for provider video. Use a general VLM with
# OCR capability; do not point this at ShotVL.
FIDELITY_VLM_URL=
FIDELITY_VLM_MODEL=
FIDELITY_VLM_MODEL_REVISION=
FIDELITY_VLM_THRESHOLD=0.88
# Optional paid cloud adapters. They stay disabled while their API key Secret is absent.
VEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VEO_MODEL=veo-3.1-fast-generate-preview
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=
# Secrets (LOCAL_LLM_API_KEY, MONGO_URI, S3_ACCESS_KEY, S3_SECRET_KEY) are
# injected from Kubernetes Secret and must never be placed in this file.
# LOCAL_LLM_API_KEY, SHOTVL_API_KEY, FIDELITY_VLM_API_KEY, VEO_API_KEY and
# SEEDANCE_API_KEY and WAN_API_KEY follow the same rule.
MONGO_DATABASE=kwanni
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=llm-api
S3_PREFIX=mission-zero
